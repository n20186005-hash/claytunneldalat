---
import { PHOTO_SOURCES, type PhotoKey } from "../data/site";
interface Props {
  photo: PhotoKey;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
}
const { photo, alt, class: klass, loading = "lazy" } = Astro.props;
---

<img
  src={PHOTO_SOURCES[photo]}
  alt={alt}
  class={klass ?? "photo"}
  loading={loading}
  decoding="async"
  width="1200"
  height="800"
/>
