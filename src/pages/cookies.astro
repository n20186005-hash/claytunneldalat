---
import BaseLayout from "../layouts/BaseLayout.astro";
const sections = {
  en: [
    "Cookies and browser choices",
    "This source sets no optional analytics or advertising cookies and no longer writes the former cookie-choice preference. Embedded Google Maps and browser weather requests still contact their providers as explained in the privacy information. No on-page cookie button controls these services or Cloudflare edge processing. Use your browser settings to manage stored site data or block third-party content; this may affect features and does not erase previously transmitted data.",
  ],
  vi: [
    "Cookie và lựa chọn trình duyệt",
    "Mã nguồn không đặt cookie phân tích hay quảng cáo tùy chọn và không còn ghi lựa chọn cookie cũ. Google Maps nhúng và yêu cầu thời tiết vẫn liên hệ nhà cung cấp như thông tin quyền riêng tư. Không có nút cookie trong trang điều khiển các dịch vụ này hay xử lý Cloudflare tại biên. Dùng cài đặt trình duyệt để quản lý dữ liệu lưu hoặc chặn nội dung bên thứ ba; có thể ảnh hưởng tính năng và không xóa dữ liệu đã gửi.",
  ],
  zh: [
    "Cookie與瀏覽器選擇",
    "此份原始碼不設定可選分析或廣告Cookie，也不再寫入舊的Cookie選擇。Google地圖與天氣請求仍依隱私說明聯絡提供者；沒有頁面Cookie按鈕控制這些服務或Cloudflare邊緣處理。請用瀏覽器設定管理儲存資料或阻擋第三方內容，可能影響功能，且不會刪除已傳送資料。",
  ],
  ko: [
    "쿠키와 브라우저 선택",
    "이 소스는 선택적 분석·광고 쿠키를 설정하지 않고 이전 쿠키 선택 값도 더 이상 쓰지 않습니다. 삽입 지도와 브라우저 날씨 요청은 개인정보 안내에 따라 제공자에 연결합니다. 페이지 쿠키 버튼이 이 서비스나 Cloudflare 엣지 처리를 제어하지 않습니다. 브라우저 설정으로 저장 데이터나 제3자 콘텐츠를 관리하세요. 기능에 영향이 있을 수 있으며 이미 전송된 데이터는 지워지지 않습니다.",
  ],
};
---

<BaseLayout
  locale="en"
  routeKey="home"
  canonicalOverride="/cookies/"
  title="Cookie information | Clay Tunnel Da Lat Guide"
  description="Actual browser cookie and third-party service information."
  noIndex
  i18n={false}
  ><section class="mx-auto max-w-4xl px-5 py-16">
    <h1 class="display text-4xl">Cookie information</h1>{
      Object.entries(sections).map(([lang, s]) => (
        <section lang={lang === "zh" ? "zh-Hant" : lang} class="mt-10">
          <>
            <h2 class="text-2xl font-bold">{s[0]}</h2>
            <p class="mt-5 leading-8">{s[1]}</p>
          </>
        </section>
      ))
    }<p class="mt-8">
      <a class="underline" href="/privacy/"
        >Privacy · Quyền riêng tư · 隱私 · 개인정보</a>
    </p>
  </section></BaseLayout
>
