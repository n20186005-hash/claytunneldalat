---
import { localizedPath, ui, type Locale } from '../i18n';
import { ATTRACTION as A, MAPS_EMBED } from '../data/site';
import { guides } from '../content';
import { topics, type TopicKey } from '../content/topics';
import Photo from './Photo.astro';

interface Props {
  locale: Locale;
  topic: TopicKey;
}

const { locale, topic } = Astro.props;
const t = ui[locale];
const g = guides[locale];
const page = topics[locale][topic];
const home = localizedPath(locale, 'home');
const others = (['ticket', 'transport', 'highlights'] as TopicKey[]).filter((k) => k !== topic);
const photos: Record<TopicKey, 'tunnel' | 'tunnel2' | 'lake'> = {
  ticket: 'tunnel2',
  transport: 'lake',
  highlights: 'tunnel'
};
---

<section class="bg-[var(--ink)] py-16 text-white">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <nav class="text-sm text-white/65" aria-label="breadcrumb">
      <a href={home} class="underline">{t.breadcrumb.home}</a> › <span>{page.h1}</span>
    </nav>
    <p class="kicker mt-6 text-[#b9d8d1]">{g.heroKicker}</p>
    <h1 class="display mt-4 text-4xl leading-tight sm:text-5xl">{page.h1}</h1>
    <p class="mt-6 text-lg leading-8 text-white/85">{page.lead}</p>
  </div>
</section>

<section class="py-16">
  <div class="mx-auto grid max-w-4xl gap-10 px-5 lg:px-8">
    {page.sections.map((section, i) => (
      <article>
        <h2 class="display text-3xl">{section.title}</h2>
        {section.paragraphs.map((p) => <p class="mt-4 leading-8 text-slate-700">{p}</p>)}
        {section.bullets && (
          <ul class="mt-5 space-y-2 pl-1">
            {section.bullets.map((b) => (
              <li class="flex gap-3 leading-7 text-slate-700"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--sun)]"></span><span>{b}</span></li>
            ))}
          </ul>
        )}
        {i === 0 && (
          <div class="mt-7 overflow-hidden rounded-[1.8rem] border border-[#0a2931]/10">
            <Photo photo={photos[topic]} alt={g.photoAlt[photos[topic]]} class="photo aspect-[16/9]" />
          </div>
        )}
      </article>
    ))}

    <p class="text-sm leading-6 text-slate-500">{page.updated}</p>
    <p class="text-sm leading-6 text-slate-500">{g.disclaimer}</p>
  </div>
</section>

<section id="faq" class="border-y border-[#0a2931]/10 bg-white py-20">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <p class="kicker text-[var(--sea)]">{g.faq.kicker}</p>
    <h2 class="display mt-3 text-4xl">{g.faq.title}</h2>
    <div class="mt-8 space-y-5">
      {page.faq.map((item) => (
        <details class="card shell p-6 [&_summary]:cursor-pointer [&_summary]:text-lg [&_summary]:font-black">
          <summary>{item.q}</summary>
          <p class="mt-4 leading-7 text-slate-700">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="py-20">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <div class="shell overflow-hidden border border-[#0a2931]/10 bg-[#dbe7df] p-2">
      <iframe title={`Map of ${A.nameVi}`} class="h-[420px] w-full rounded-[1.6rem] border-0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" src={MAPS_EMBED}></iframe>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={A.mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#0a2931] px-6 py-3 text-sm font-black text-white">{t.cta.directions}</a>
      <a href={`tel:${A.phone}`} class="rounded-full border border-[#0a2931]/25 px-6 py-3 text-sm font-black">{t.cta.call}</a>
      <a href={home} class="rounded-full border border-[#0a2931]/25 px-6 py-3 text-sm font-black">{t.breadcrumb.home} ↗</a>
    </div>
  </div>
</section>

<section class="pb-24">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <p class="kicker text-[var(--sea)]">{g.explore.kicker}</p>
    <h2 class="display mt-3 text-4xl">{g.explore.title}</h2>
    <div class="mt-7 grid gap-6 sm:grid-cols-2">
      {others.map((key) => (
        <a href={localizedPath(locale, key)} class="card shell block p-7 hover:bg-white">
          <h3 class="display text-2xl">{topics[locale][key].h1}</h3>
          <p class="mt-3 leading-7 text-slate-700">{topics[locale][key].card}</p>
        </a>
      ))}
    </div>
  </div>
</section>
