---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ATTRACTION as A, withSiteName } from '../data/site';

const locale = 'en' as const;
const title = withSiteName(locale, 'Cookie settings');
const description = `Cookie and local-storage settings for the independent ${A.nameVi} (${A.nameEn}) visitor guide.`;
---

<BaseLayout locale={locale} routeKey="home" canonicalOverride="/cookies/" title={title} description={description} noIndex i18n={false}>
  <section class="py-16">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <a href="/" class="text-sm font-black underline">← Back to the guide</a>
      <h1 class="display mt-8 text-5xl">Cookie settings</h1>
      <div class="mt-8 space-y-5 leading-8 text-slate-700">
        <p>This guide loads no analytics and no advertising by default. The only value it can store in your browser is a local preference that remembers your choice in the cookie notice.</p>
        <p>Third-party content you choose to open — for example Google Maps or Wikimedia Commons — is governed by the policies of those providers.</p>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <button id="necessary" class="rounded-full border border-slate-300 px-5 py-3 font-black">Essentials only</button>
        <button id="optional" class="rounded-full bg-[#e99a54] px-5 py-3 font-black text-[#08232b]">Accept optional</button>
        <button id="clear" class="rounded-full border border-slate-300 px-5 py-3 font-black">Clear preference</button>
      </div>
      <p id="status" class="mt-5 text-sm text-slate-600" aria-live="polite"></p>
    </div>
  </section>

  <script>
    const key = 'ctd-cookie-choice';
    const status = document.getElementById('status');
    const paint = () => {
      const value = localStorage.getItem(key);
      if (status) {
        status.textContent = value
          ? `Current preference: ${value === 'accepted' ? 'optional accepted' : 'essentials only'}.`
          : 'No preference is stored yet.';
      }
    };
    document.getElementById('necessary')?.addEventListener('click', () => {
      localStorage.setItem(key, 'necessary');
      paint();
    });
    document.getElementById('optional')?.addEventListener('click', () => {
      localStorage.setItem(key, 'accepted');
      paint();
    });
    document.getElementById('clear')?.addEventListener('click', () => {
      localStorage.removeItem(key);
      paint();
    });
    paint();
  </script>
</BaseLayout>
