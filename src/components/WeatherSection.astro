---
import { ui, type Locale } from "../i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].weather;
const copy = {
  en: {
    title: "Regional weather for Da Lat",
    loading: "Loading a regional model forecast in your browser…",
    refresh: "Refresh forecast",
    note: "Open-Meteo regional model, not an on-site observation, official warning or access notice. Values expire after 15 minutes in this page; Vietnam time (UTC+7).",
  },
  vi: {
    title: "Thời tiết khu vực Đà Lạt",
    loading: "Đang tải dự báo mô hình khu vực trong trình duyệt…",
    refresh: "Tải lại dự báo",
    note: "Mô hình khu vực Open-Meteo, không phải quan trắc tại điểm đến, cảnh báo chính thức hay thông báo mở cửa. Dữ liệu trên trang hết hạn sau 15 phút; giờ Việt Nam (UTC+7).",
  },
  zh: {
    title: "大叻區域天氣",
    loading: "正在瀏覽器載入區域模式預報…",
    refresh: "重新載入預報",
    note: "Open-Meteo區域模式，非景點現場觀測、官方警報或通行公告。本頁數值15分鐘後失效；越南時間UTC+7。",
  },
  ko: {
    title: "달랏 지역 날씨",
    loading: "브라우저에서 지역 모델 예보를 불러오는 중…",
    refresh: "예보 새로고침",
    note: "Open-Meteo 지역 모델이며 현장 관측, 공식 경보나 출입 공지가 아닙니다. 이 페이지의 값은 15분 뒤 만료됩니다. 베트남 시간 UTC+7.",
  },
}[locale];
---

<section
  id="weather"
  data-weather
  data-locale={locale}
  data-loading={copy.loading}
  class="border-y border-[#0a2931]/10 bg-[#f7f6ef] py-20"
>
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="kicker text-[var(--sea)]">{t.kicker}</p><h2
      class="display mt-3 text-4xl"
    >
      {copy.title}
    </h2><p class="mt-5 max-w-3xl text-sm leading-7">
      {copy.note}
      <a href="https://open-meteo.com/" class="font-bold underline"
        >Open-Meteo</a
      > · <a href="https://open-meteo.com/en/docs" class="underline">API</a> · <a
        href="https://creativecommons.org/licenses/by/4.0/"
        class="underline">CC BY 4.0</a
      > · {
        {
          en: "Values rounded for display.",
          vi: "Giá trị được làm tròn khi hiển thị.",
          zh: "數值經四捨五入顯示。",
          ko: "표시 값은 반올림됩니다.",
        }[locale]
      }
    </p><p data-wx-status class="mt-6 leading-7" role="status">
      {t.unavailable}
    </p><div data-wx-results hidden class="mt-7"></div><button
      data-wx-refresh
      class="mt-6 min-h-11 rounded-full bg-[#0a2931] px-6 py-3 font-bold text-white"
      >{copy.refresh}</button
    ><noscript><p class="mt-4">{t.unavailable}</p></noscript>
  </div>
</section>
<script>
  import { ui, type Locale } from "../i18n";
  import { WEEKDAYS } from "../data/weather-i18n";
  import {
    getWeather,
    buildAdvice,
    kmhToBeaufort,
    wmoLabel,
    MAX_CLIENT_AGE,
    type WeatherData,
  } from "../lib/weather";
  const root = document.querySelector<HTMLElement>("[data-weather]");
  if (root) {
    const locale = root.dataset.locale as Locale,
      t = ui[locale].weather;
    const status = root.querySelector<HTMLElement>("[data-wx-status]")!,
      results = root.querySelector<HTMLElement>("[data-wx-results]")!,
      button = root.querySelector<HTMLButtonElement>("[data-wx-refresh]")!;
    let current: WeatherData | null = null,
      busy = false,
      nextRefresh = 0;
    const element = (tag: string, text: string, className = "") => {
      const e = document.createElement(tag);
      e.textContent = text;
      e.className = className;
      return e;
    };
    const unavailable = () => {
      current = null;
      results.replaceChildren();
      results.hidden = true;
      status.textContent = t.unavailable;
    };
    const render = (w: WeatherData) => {
      results.replaceChildren();
      const columns = element("div", "", "grid gap-6 md:grid-cols-2");
      const conditions = element(
        "div",
        "",
        "shell border border-[#0a2931]/15 bg-white p-6",
      );
      conditions.append(
        element(
          "h3",
          `${w.current.temp}°C · ${wmoLabel(w.current.code, locale)}`,
          "text-2xl font-bold",
        ),
      );
      const dl = element("dl", "", "mt-5 grid grid-cols-2 gap-4");
      const rows = [
        [t.feels, `${w.current.apparent}°C`],
        [t.humidity, `${w.current.humidity}%`],
        [
          t.wind,
          `${w.current.windKmh} km/h · ${kmhToBeaufort(w.current.windKmh)} ${t.beaufort}`,
        ],
        [t.rain, `${w.todayRain}%`],
        [t.uv, String(w.todayUv)],
        [
          t.updated,
          new Date(w.updatedAt).toLocaleString(
            { en: "en-GB", vi: "vi-VN", zh: "zh-TW", ko: "ko-KR" }[locale],
            { timeZone: "Asia/Ho_Chi_Minh", hour12: false },
          ) + " UTC+7",
        ],
      ];
      for (const [name, value] of rows) {
        const group = element("div", "");
        group.append(
          element("dt", name, "text-sm"),
          element("dd", value, "mt-1 font-bold"),
        );
        dl.append(group);
      }
      conditions.append(dl);
      const forecast = element(
        "div",
        "",
        "shell border border-[#0a2931]/15 bg-white p-6",
      );
      forecast.append(element("h3", t.forecast, "text-xl font-bold"));
      const list = element("ul", "", "mt-4 space-y-3");
      for (const day of w.daily) {
        const weekday =
          WEEKDAYS[locale][new Date(day.date + "T12:00:00Z").getUTCDay()];
        list.append(
          element(
            "li",
            `${day.date} · ${weekday}: ${wmoLabel(day.code, locale)} · ${day.min}° / ${day.max}°`,
            "text-sm leading-7",
          ),
        );
      }
      forecast.append(list);
      columns.append(conditions, forecast);
      results.append(columns);
      const advice = buildAdvice(w, locale),
        groups = element("div", "", "mt-6 grid gap-5 md:grid-cols-2");
      for (const key of ["risk", "outfit", "plan", "items"] as const) {
        if (!advice[key].length) continue;
        const group = element(
          "div",
          "",
          "shell border border-[#0a2931]/15 bg-white p-6",
        );
        group.append(element("h3", t[key], "font-bold"));
        const ul = element("ul", "", "mt-3 space-y-2 text-sm leading-7");
        for (const line of advice[key]) ul.append(element("li", line));
        group.append(ul);
        groups.append(group);
      }
      results.append(groups);
      results.hidden = false;
      status.textContent = "";
    };
    const refresh = async () => {
      if (busy) return;
      busy = true;
      button.disabled = true;
      nextRefresh = Date.now() + MAX_CLIENT_AGE;
      if (!current) status.textContent = root.dataset.loading ?? t.unavailable;
      try {
        const data = await getWeather();
        if (data) {
          current = data;
          render(data);
        } else unavailable();
      } finally {
        busy = false;
        button.disabled = false;
      }
    };
    const check = () => {
      if (current && Date.now() - current.fetchedAt >= MAX_CLIENT_AGE)
        unavailable();
      if (!document.hidden && Date.now() >= nextRefresh) void refresh();
    };
    button.addEventListener("click", () => void refresh());
    document.addEventListener("visibilitychange", check);
    setInterval(check, 60000);
    void refresh();
  }
</script>
