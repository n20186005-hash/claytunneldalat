---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ATTRACTION as A, PHOTO_SOURCES, withSiteName } from '../data/site';

const locale = 'en' as const;
const title = withSiteName(locale, 'Photo credits');
const description = `Sources and licences of the photographs used on the ${A.nameVi} (${A.nameEn}) visitor guide.`;
const credits = [
  { file: 'clay-tunnel-hero.jpg', label: 'Đường vào đường hầm điêu khắc đất sét - panoramio.jpg' },
  { file: 'clay-tunnel-tunnel.jpg', label: 'Đường vào đường hầm điêu khắc đất sét - panoramio (1).jpg' },
  { file: 'clay-tunnel-lake.jpg', label: 'Đường vào đường hầm điêu khắc đất sét quanh hồ tuyền lâm - panoramio.jpg' },
  { file: 'clay-tunnel-tunnel2.jpg', label: 'Đường vào đường hầm điêu khắc đất sét - panoramio (2).jpg' },
  { file: 'clay-tunnel-lake2.jpg', label: 'Đường vào đường hầm điêu khắc đất sét quanh hồ tuyền lâm - panoramio (1).jpg' }
];
---

<BaseLayout locale={locale} routeKey="home" canonicalOverride="/photo-credits/" title={title} description={description} noIndex i18n={false}>
  <section class="py-16">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <a href="/" class="text-sm font-black underline">← Back to the guide</a>
      <h1 class="display mt-8 text-5xl">Photo credits</h1>
      <p class="mt-5 leading-8 text-slate-700">
        The photographs are real images of {A.nameVi} ({A.nameEn}) from Wikimedia Commons, migrated from Panoramio. The repository
        includes a script that stores them locally under the names the site uses.
      </p>
      <div class="mt-10 space-y-6 text-sm leading-6 text-slate-700">
        {credits.map((credit) => (
          <p>
            <strong>{credit.file}</strong> — {credit.label}
            <br />
            <a href={PHOTO_SOURCES.hero} target="_blank" rel="noopener noreferrer" class="underline">Wikimedia Commons</a> (Panoramio) · CC BY-SA.
          </p>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
